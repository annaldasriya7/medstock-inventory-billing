# ==========================================
# MedStock AI - Environment Configuration Example
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/medstock_ai?retryWrites=true&w=majority
# Or local: mongodb://127.0.0.1:27017/medstock_ai
MONGODB_URI=mongodb://127.0.0.1:27017/medstock_ai

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRE=7d

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Frontend (client/.env)
# VITE_API_URL=http://localhost:5000/api
